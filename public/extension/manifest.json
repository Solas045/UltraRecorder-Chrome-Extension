{
  "manifest_version": 3,
  "name": "UltraRec - 4K 60FPS Screen Recorder",
  "version": "1.0.0",
  "description": "Production-ready screen recorder for Chrome supporting up to 4K resolution at 60fps with system and microphone audio mixing.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabCapture",
    "desktopCapture",
    "downloads",
    "offscreen"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "UltraRec Screen Recorder",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Start or stop screen recording"
    }
  }
}
